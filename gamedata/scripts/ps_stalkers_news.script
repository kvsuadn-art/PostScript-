local ps_stalkers_news={
"%c[default]Отец Валерьян: \\n%c[255,243,122,11]Одиночки, вольные ходоки, объединяйтесь, дадим отпор военным и обнаглевшим бандитам. Я на базе, во втором бараке, Кордон",
"%c[255,243,122,11]Сейчас охраняем ученых на Янтаре, своих сил не хватает, то бюреры, то контролеры, то зомбированные,есть работа - обращайтесь, да, и Сахоров просит подогнать кого-нибудь.",
"%c[255,243,122,11]Военные охренели, только что заломали нашего и ьандитам отдали, надо что-то делать...",
"%c[255,243,122,11]Внимание, в заброшенном доме замечены бандиты, надо кого-нить туда направить, не бесплатно конечно",
"%c[255,243,122,11]Никто не знает уто-такой Стрелок? Тут одна группировка интересовалась им, денег много предлагали.",
"%c[255,243,122,11]Пробились в Рыжий лес, чуть от страху не померли, кого тут только нет, даже пси-собаки...",
"%c[255,243,122,11]Нужен сталкер, желательно со стороны, для деликатной работы, обращайтесь на базу...",
"%c[255,243,122,11]Замечен лагерь бандитов, рядом с болотом на Агропроме, и в тунеле, что-то затевают",
"%c[255,243,122,11]Срочно нужна помощь, зомбированные так и прут с Янтаря, не удержать, болота Агропр......ааа..мать.",
"%c[255,243,122,11]Что-то мутантов развелось",
"%c[255,243,122,11]Прани, наши сказали, что какого-то военного поямали и в клетке на базе держут, вот это да.",
"%c[255,243,122,11]В Темную Долину никак, у Свободы карантин, кто-то их там покусывает и серьезно,  еще говорят что крыса завелась в штабе."
}


function get_strings()
	local uniq=ps_stalkers_news[math.random(table.getn(ps_stalkers_news))]
	return uniq
end
