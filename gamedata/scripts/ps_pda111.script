class "PageEnc" (CUIWindow)
function PageEnc:__init(parent) super()
	self.parent = parent
	self.list_contents = self.parent.list_contents
	
	self:init_interface()
	self:init_callbacks()
	self:init_values()
end

function PageEnc:init_interface()
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_pda_enc.xml")
	
	xml:InitStatic("frame_enc",self)
	
	self.item_name = xml:InitStatic("label_itemName", self)
	self.item_pic = xml:InitStatic("label_itemPicture", self)
	self.scroll_window = xml:InitScrollView("scroll_window", self)
	self.enc_descr = xml:InitStatic("label_encyclopedia", self.scroll_window)
end

function PageEnc:init_callbacks()

end

function PageEnc:init_values()
	self.content_main_size = vector2():set(220,22)
	self.content_text_size = vector2():set(220,22)
	self.content_info_size = vector2():set(0,0)
	self.description_main_size = vector2():set(270,20)
	self.description_text_size = vector2():set(270,20)

	self.list_contents:RemoveAll()
	self.list_contents:ScrollToBegin()
	self.list_contents:ShowSelectedItem(false)
	
	for k,v in pairs(encyclopedia_items) do
		if db.actor:has_info(v) then
			self:addContentItem(game.translate_string(tostring(v.."_name")), tostring(v))
		end
	end

end

function PageEnc:addContentItem(text, info)
	local element = content_list_item()
	element:SetWndSize(self.content_main_size)
	element.label_text:SetWndSize(self.content_text_size)
	element.label_text:SetWndPos(vector2():set(0,0))
	element.label_text:SetText(tostring(text))
	element.label_info:SetWndSize(self.content_info_size)
	element.label_info:SetWndPos(vector2():set(0,0))
	element.label_info:Show(false)
	element.label_info:SetText(tostring(info))
	
	self.list_contents:AddItem(element)
end

function PageEnc:showDescription(name, info)
	self.item_name:SetText(tostring(name))
	local texture = "ui_"..info
	local alias = item_alias[info] 
	if alias ~= nil then
		texture = alias
	end
	self.item_pic:InitTexture(tostring(texture))
	
	local descr = game.translate_string(tostring(info.."_descr"))
	self.enc_descr:SetText(descr)
end


-- Tasks Page

class "PageTasks" (CUIWindow)
function PageTasks:__init(parent) super()
	self.parent = parent
	
	self:init_interface()
	self:init_callbacks()
	self:init_values()
end

function PageTasks:init_interface()
	local xml = CScriptXmlInit()
end

function PageTasks:init_callbacks()

end

function PageTasks:init_values()
end
