local ps_mercenaries_news={
"%c[default]Леший:\\n%c[236,255,18,11]Мэд Дей, попали в какую-то хренотень в Лиманске, выхода нет, кто может помогите, скоро вода кончится,\\n со мной семеро парней, в долгу не останемся.",
"%c[236,255,18,11]Эфир не забиваем, ваши подвиги по убийству левых мужиков никого не интересуют.Вот еслиб вы про наши узнали , вот тогда да...",
"%c[236,255,18,11]Синдикат набирает бойцов, чтобы вступить найдите посредника, вот ваше первое задание...",
"%c[236,255,18,11]Информацию по рейдам на мутантов и другим операциям - можно купить у Лешего и Шрама",
"%c[236,255,18,11]Матерь божья, пропал Шрам, вел ученых на болота, потом выброс и все, паячок сгорел, за инфу где он заплатим.",   
"%c[236,255,18,11]Нужны опытные сталкеры для рейда на одну группировку",
"%c[236,255,18,11]Внимание, в настоящий момент в сендикате раскол, группа во главе с Гюрзой занимается \\n работой противоречущей кодексу, увидети их, мочите, будем только благодарны.",
"%c[236,255,18,11]Андрей Лунев по кличке старый, бывший разводящий объявлен вне закона, за его голову платим большие деньги.",
"%c[236,255,18,11]Петренко, а ну отвечай, мать твою! Это ты , урод, украл нашу технологию привата, который даже спутник не берет?!",
"%c[default]Леший:\\n%c[236,255,18,11]Находимся в Лиманске, иногда бывем в Рыжем лесу.",
"%c[default]Макс-Крюгер:\\n%c[236,255,18,11]За информацию о Старом , плачу большие деньги, или даю другую онформацию.",
"%c[default]Андрей Лунев:\\n%c[236,255,18,11]И что вы ко мне приципились? Делов нет чтоли других? Все равно не найдете...."
}

function get_strings()
	local news=ps_mercenaries_news[math.random(table.getn(ps_mercenaries_news))]
	return news
end