local ps_bandits_news={
"%c[default]Йога\\n%c[255,129,129,11]Ну шо, Свобода с Долгом, получили маслин, будете знать как нас обижать.",
"%c[default]Йога\\n%c[255,129,129,11]Требуется человечек для работки, обращаться ко мне, к Борову не ходите и не слушайте его.",
"%c[default]Йога\\n%c[255,129,129,11]Петренко, то шо охренел? Какого глушишь наш канал?",
"%c[255,129,129,11]Ага, поймали мы диггеров, теперь в концлагере пашут!",
"%c[255,129,129,11]Усе, свалка наша, и никто нас не выгонит остюда.",
"%c[255,129,129,11]Ааа, уроды Сталкеры, прижали нас в концлагере, уже все подступы захватили....",
"%c[255,129,129,11]Мля, шо за гопники завалили бригадира, яйца на уши натяну.",
"%c[255,129,129,11]Вступайте к нам и будет вам хорошо, делай шо хошь!",
"%c[255,129,129,11]Во твари разошлись, и чего им в лесу не сидится?",
"%c[255,129,129,11]Суки... мерк.... так это вы валите Свободов...."

}

function get_strings()
	local news=ps_bandits_news[math.random(table.getn(ps_bandits_news))]
	return news
end