local ps_freedom_news={
"%c[50,1,200,11]Да здравствует Свобода! Сделаем мир при помощи Зоны лучше!",
"%c[50,1,200,11]Вступайте в Свободу! Остановим захват Зоны!",
"%c[50,1,200,11]Нужны опытные сталкеры для рейда за артефактами. С нас причитается.",
"%c[50,1,200,11]Одиночки! Говорит «Свобода»! Если хотите жить в нормальных условиях в Зоне и без армейской обязаловки, как у долга - двигайте к нам! Всегда рады новым лицам.",
"%c[50,1,200,11]Всем нашим - срочно зайти на приватный канал, обновляем защиту. Потом не жалуйтесь, что о вашем рейде Долг узнал.",
"%c[50,1,200,11]Если находитесь на задании, всю информацию - в приватный канал. Этот не только наши читают, не палитесь.",
"%c[default]Чехов:\\n%c[50,1,200,11]Данные по передвижению мерков сразу скидываем мне в приват, это действительно важно.",
"%c[50,1,200,11]Наткнулись на сопротивление фанатиков, устроили заслон, нам помогуют одиночки, кто может подтягивайтесь.",
"%c[50,1,200,11]Милитари под нашем контролем, но есть инфа, что группа Долга где-то поблизости",
"%c[50,1,200,11]Хотите апгрейдить G36 и FN 2000 - Обращайтесь к Яру.",
"%c[50,1,200,11]Неоходим смелый стрелок, я на северном блокпосте Складов.",
"%c[50,1,200,11]Внимание,Темная долина на карантине, наших ребят кто-то в тихую валит, у кого есть информация, делитесь",
"%c[50,1,200,11]Мопасаран!",
"%c[50,1,200,11]Радар закрыт, такое пси-излучение - моментом мозг сгорает."
}

function get_strings()
	local news=ps_freedom_news[math.random(table.getn(ps_freedom_news))]
	return news
end