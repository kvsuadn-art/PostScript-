[logic]
active = ph_door@closed

[ph_door@closed]
locked = false
closed = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_use = {-yan_alarm_signal_stalkers_cut2 -yan_door2_open} ph_door@open %+yan_door1_open%
on_info = {=surge_npc_near_door} ph_door@force_open
on_info2 = {+yan_alarm_signal_stalkers_cut2} ph_door@locked

[ph_door@open]
locked = false
closed = false
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_use = ph_door@closed %-yan_door1_open%
on_info = {=surge_npc_near_door} ph_door@force_open
on_info2 = {+yan_alarm_signal_stalkers_cut2} ph_door@locked
on_timer = 3000 | ph_door@closed %-yan_door1_open%

[ph_door@locked]
locked = true
closed = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {=surge_npc_near_door} ph_door@force_open
on_info2 = {-yan_alarm_signal_stalkers_cut2} ph_door@closed

[ph_door@force_open]
locked = true
closed = false
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {!surge_npc_near_door} ph_door@closed