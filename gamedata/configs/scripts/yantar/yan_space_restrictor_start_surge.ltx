on_info = {+yan_quest_levsha} sr_idle@stop_surge

[sr_idle@stop_3]
on_game_timer = 150 |  sr_idle@safe_3 %-start_surge% 

[sr_idle@safe_3]
on_game_timer = 1 | sr_idle@warn_4 %=send_safe_message%


;Fourth Surge
[sr_idle@warn_4]
on_game_timer = 8300 | sr_idle@start_surgee_4 %=send_danger_message%

[sr_idle@start_surge_4]
on_game_timer = 1000 | sr_idle@stop_4 %+start_surge -yan_ready_actor_cut2 =stc_boom% 
