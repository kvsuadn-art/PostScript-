[logic]
active = sr_idle@check

[sr_idle@check]
on_game_timer = 1000 | sr_idle@spawn_walker

[sr_idle@spawn_walker]
on_info = {!counter_greater(yan_zombie_walker_count:8) =dist_to_actor_ge(100)} sr_idle@check %=inc_counter(yan_zombie_walker_count) =spawn_object(yan_zombie_walker:yan_zombie_spawn)%
