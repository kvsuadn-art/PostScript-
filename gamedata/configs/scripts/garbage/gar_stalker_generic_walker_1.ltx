[logic]
active = mob_home@base
on_death = death
on_hit = hit

;roam sequence
[mob_home@base]
path_home = gar_walker_home
home_min_radius = 10
home_max_radius = 40
on_game_timer = 500 | {=random_chance(10:4000)} walker@dig_1, {=random_chance(10:4000)} walker@dig_2, {=random_chance(10:4000)} walker@dig_3, {=random_chance(10:4000)} walker@dig_4, {=random_chance(10:4000)} walker@dig_5, {=random_chance(10:4000)} walker@dig_6

;transition sequences
[walker@shift]
path_look = gar_walker_home
path_walk = gar_walker_home
;on_info = mob_home@wait
on_game_timer = 5 | mob_home@wait

[mob_home@wait]
path_home = gar_walker_home
home_min_radius = 10
home_max_radius = 40
on_game_timer = 2500 | mob_home@base

;search sites
[walker@dig_1]
path_look = gar_dig_site_1_look
path_walk = gar_dig_site_1_walk
on_signal = path_end | walker@dig_1_s

[walker@dig_1_s]
anim = search
target = gar_dig_site_1_look, 0
path_look = gar_dig_site_1_look
path_walk = gar_dig_site_1_walk
;on_signal = anim_end | walker@dig_1_1
on_game_timer = 50 | walker@dig_1_1

