[logic]
active = sr_idle@start

[sr_idle@start]
on_info = {+gar_quest_killer_pseudodogs_started =is_dark_night} sr_idle@spawn_selection

[sr_idle@spawn_selection]
on_info = {=dist_to_actor_ge(100)} sr_idle@spawn_in_forest, sr_idle@spawn_by_garbage

[sr_idle@spawn_in_forest]
on_info = sr_idle@end_section %=create_squad(gar_killer_pseudodogs_in_forest:gar_smart_terrain_5_6)%

[sr_idle@spawn_by_garbage]
on_info = sr_idle@end_section %=create_squad(gar_killer_pseudodogs_by_garbage:gar_smart_terrain_5_6)%

[sr_idle@end_section]