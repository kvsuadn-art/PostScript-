[red_artefact_hunters_defend_squad]
type = storyline
task_type = additional
icon = ui_mt_image_attack_tower
target_cond = {+red_artefact_hunters_go -red_artefact_hunters_task_complete} true
prior = 9
name = red_artefact_huntesr_capture_smart_name
text = red_artefact_huntesr_capture_smart_text
target_story_ids = 519
spot = secondary_task_location_complex
condlist_0 = {+red_artefact_hunters_task_complete} complete
condlist_1 = {+red_artefact_hunters_task_fail} fail
play_regard = nil

[red_artefact_huntesr_defend_smart]
type = defend_smart
task_type = additional
icon = ui_mt_image_attack_tower
target_cond = {=squad_exist(red_stalker_artefact_hunters_1) !is_smart_defending(red_smart_terrain_6_3) =target_smart_name(red_smart_terrain_6_3) -red_artefact_hunters_task_2_complete +red_artefact_hunters_task_complete} true
prior = 7
name = red_artefact_huntesr_defend_smart_name
text = red_artefact_huntesr_defend_smart_text
on_complete = % +red_artefact_hunters_task_2_complete%
;reward_money = 2500
reward_item = af_cristall_flower

[red_forest_stalker_bring_map]
type = recover_item
task_type = additional
icon = ui_mt_image_attack_tower
target_cond = {-red_forest_allyes_have_map =check_npc_squad(red_stalker_artefact_hunters_1)}
prior = 9
name = red_forest_stalker_bring_map_name
text = red_forest_stalker_bring_map_text
requested_items = red_forest_pda_map
on_complete = %+red_forest_allyes_have_map%
reward_money = 1000

[red_stalker_reinforced]
type = capture_smart
task_type = additional
icon = ui_mt_image_attack_tower
target_cond = {=target_smart_name(red_smart_terrain_3_2) =actor_on_level(red_forest) -red_capture_undeground_camp_done}
prior = 7
name = red_stalker_reinforced_name
text = red_stalker_reinforced_text
on_complete = %+red_capture_undeground_camp_done%
reward_money = 3000


