[bread_rad]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency =
$spawn 				= "food and drugs\bread_rad"
;$prefetch 			= 32
class				= II_FOOD
cform				= skeleton
visual				= dynamics\devices\dev_bred\dev_bred.ogf
description			= st_bread_rad_descr

inv_name			= st_bread_rad
inv_name_short		= st_bread_rad
inv_weight			= 0.3	;0.2

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 11
inv_grid_y			= 9
cost				= 0

attach_angle_offset		= -0.287979, 1.560923, 1.544060
attach_position_offset	= 0.096910, -0.013594, 0.107925
attach_bone_name		= bip01_r_hand
auto_attach				= false

// should be deleted after update
bone_name				= bip01_r_hand
position_offset			 = 0.0,0.0,0.0
angle_offset			 = 1.570790,1.570790,3.92699

; eatable item
eat_health = 0.05
eat_satiety = 0.2
eat_power = 0
eat_radiation = 0
wounds_heal_perc = 0
eat_portions_num = -1

; food item
slot				= -1
animation_slot		= 4

;hud item
hud = wpn_vodka_hud

